# API Key Google Gemini (opsional jika diisi lewat Settings di UI)
GEMINI_API_KEY=

# Model default
DEFAULT_MODEL=gemini-4-hydrogen

# Port backend SSE server
PORT=3001

# Set true jika ingin default menjalankan simulasi SSE lokal
DEMO_MODE=false

# Opsional: Upstash Redis REST API untuk sinkronisasi cooldown API Key di Vercel Edge (Free Tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional: Daytona Cloud Sandbox untuk real npm install & Vite preview
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
